{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/cli/package.json",
        "$TURBO_ROOT$/packages/*/capability.json"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/cli/package.json",
        "$TURBO_ROOT$/packages/*/capability.json"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/cli/**",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "!$TURBO_ROOT$/**/node_modules/**"
      ]
    }
  }
}
