{
  "name": "@alfredmouelle/remix-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --env-file-if-exists=.env.local --import ./scripts/aliases.ts --import remix/node-tsx src/server.ts",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import ./scripts/aliases.ts --import remix/node-tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "email:dev": "email dev --dir src/emails --port 3001",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/server/db/seed.ts"
  },
  "dependencies": {
    "remix": "3.0.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/commit-mono": "5.3.0",
    "@t3-oss/env-core": "0.13.11",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.11.1",
    "resend": "6.32.1",
    "superjson": "2.2.6",
    "valibot": "1.5.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@faker-js/faker": "10.6.0",
    "@react-email/ui": "6.11.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.7",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
