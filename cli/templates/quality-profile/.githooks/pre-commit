#!/bin/sh

if git diff --cached --quiet --diff-filter=ACMR; then
  exit 0
fi

if ! git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 git diff --quiet --; then
  echo "pre-commit: staged files contain unstaged changes. Stage or stash those changes before committing."
  exit 1
fi

echo "pre-commit: format and lint staged files"
status=0
__QUALITY_COMMANDS__

git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 git add --

if [ "$status" -ne 0 ]; then
  echo "✖ Some issues couldn't be auto-fixed. Please review the output above, then re-commit."
  exit 1
fi
