---
import {
  COMPONENTS,
  type ComponentName,
  MINIMUM_NODE_VERSION,
  PACKAGE_MANAGERS,
} from '@alfredmouelle/stack-config'
import BaseLayout from '../layouts/BaseLayout.astro'
import { FLAG_TABLES } from '../lib/docs-flags'

const CONTENTS = [
  { id: 'quick-start', title: 'Quick start' },
  { id: 'flags', title: 'Scaffold flags' },
  { id: 'add', title: 'Add to a project' },
  { id: 'components', title: 'Components' },
  { id: 'after-creation', title: 'After creating a project' },
] as const

const COMPONENT_PROVIDES: Readonly<Record<ComponentName, string>> = {
  'date-picker': 'date picker and date range picker',
  'data-table': 'sortable and infinite data tables',
  confirm: 'waits for a yes or no answer',
  alert: 'waits for an acknowledgement',
  prompt: 'waits for text input',
  choice: 'waits for a selection',
  'confirm-passphrase': 'checks an exact phrase',
  'confirm-otp': 'checks a one-time code',
}

const packageManagerList = new Intl.ListFormat('en', { type: 'disjunction' }).format(
  PACKAGE_MANAGERS,
)

const SCAFFOLD_EXAMPLES = `# accept every default without prompts
pnpm dlx @alfredmouelle/create-stack@latest my-app --yes

# Convex with Clerk auth
pnpm dlx @alfredmouelle/create-stack@latest my-app --database convex --auth clerk

# Nx monorepo with common capabilities
pnpm dlx @alfredmouelle/create-stack@latest my-app --monorepo nx --storage --cache --jobs --errors`

const ADD_EXAMPLES = `create-stack add                                      # grouped interactive picker
create-stack add storage r2                           # one capability and provider
create-stack add cache upstash                        # swap Redis for Upstash
create-stack add --with storage=r2 --with jobs        # capability batch
create-stack add --with jobs --with component=confirm # mixed batch`

const COMPONENT_EXAMPLES = `create-stack add component date-picker                       # one component
create-stack add --with component=confirm --with component=prompt  # several components`

const DIALOG_EXAMPLE = `const ok = await Confirm.call({ title: 'Delete project?', variant: 'destructive' })
if (ok) deleteProject()

await Alert.call({ title: 'Saved', description: 'Your changes are live.' })

const name = await Prompt.call({ title: 'Rename', label: 'Name', defaultValue: 'my-app' }) // string | null

const destination = await Choice.call({
  title: 'Move to',
  options: [
    { label: 'Inbox', value: 'inbox' },
    { label: 'Archive', value: 'archive' },
  ],
}) // string | null

const confirmed = await ConfirmPassphrase.call({ title: 'Delete repository?', phrase: repository.name })

// Returning false keeps the dialog open with an error.
const verified = await ConfirmOtp.call({ title: 'Enter code', verify: (code) => api.checkOtp(code) })`

const AFTER_CREATION = `cd my-app
pnpm install     # only after --no-install; use your package manager
pnpm dev`
---

<BaseLayout
  description="create-stack CLI reference: scaffold flags, adding capabilities and components, callable dialogs, and what happens after creation."
  title="Docs · create-stack"
>
  <main class="shell">
    <header class="page-head">
      <p class="t-label">Reference</p>
      <h1 class="t-h1">CLI reference</h1>
      <p class="t-lead">
        Every flag, <code>create-stack add</code>, and what the first run leaves behind.
      </p>
    </header>

    <div class="indexed-page">
      <nav aria-label="On this page" class="section-index">
        {
          CONTENTS.map((entry) => (
            <a data-spy-target={entry.id} href={`#${entry.id}`}>
              <b>{entry.title}</b>
            </a>
          ))
        }
      </nav>
      <article class="prose">
        <section>
          <h2 id="quick-start">Quick start</h2>
          <pre><code>pnpm create @alfredmouelle/stack@latest my-app</code></pre>
          <p>
            Requires <strong>Node {MINIMUM_NODE_VERSION} or later</strong>, a package manager ({packageManagerList}), and <strong>git</strong> on <code>PATH</code>. With no flags the CLI asks for each choice. <strong>Any stack or capability flag switches to non-interactive mode</strong> for CI and scripts.
          </p>
          <p>
            The <code>project</code> argument names the target directory and becomes the default
            package name. The directory <strong>must not exist, or must be empty</strong>.
          </p>
        </section>

        <section>
          <h2 id="flags">Scaffold flags</h2>
          <p>
            Capability flags are optional: <strong>a bare flag selects the recommended provider</strong>,
            and leaving it out skips the capability. Pick the options visually in the <a href="/build">stack builder</a>, which prints the matching command.
          </p>
          {FLAG_TABLES.map((table) => (
            <div class="docs-table">
              <table class="data-table">
                <caption>{table.caption}</caption>
                <thead>
                  <tr><th scope="col">Flag</th><th scope="col">Values</th><th scope="col">Default</th><th scope="col">Notes</th></tr>
                </thead>
                <tbody>
                  {table.rows.map((row) => (
                    <tr>
                      <th scope="row">{row.flags.map((flag) => <code class="docs-flag">{flag}</code>)}</th>
                      <td>{row.values.length ? row.values.map((value, index) => [index ? ' | ' : '', <code>{value}</code>]) : '-'}</td>
                      <td><code>{row.defaultValue}</code></td>
                      <td>
                        {row.notes}
                        {row.link ? [' ', <a href={row.link.href}>{row.link.label}</a>] : null}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
          <p>When flags leave stack choices out, the CLI resolves them with these rules:</p>
          <ul>
            <li><code>--no-db</code> selects Clerk, keeps tRPC, and omits mail.</li>
            <li>Better Auth adds Drizzle when the database is omitted and Resend when the mailer is omitted.</li>
            <li>Explicit <code>--no-db</code> and <code>--no-mail</code> conflict with Better Auth.</li>
            <li>Convex cannot be used with tRPC or Better Auth. Its omitted choices become Clerk, no tRPC, and no mail.</li>
          </ul>
          <p>
            Conflicting or repeated choices, and choices the framework does not support, are reported <strong>before any file is written</strong>. Nothing is substituted.
          </p>
          <pre><code>{SCAFFOLD_EXAMPLES}</code></pre>
        </section>

        <section>
          <h2 id="add">Add to a project</h2>
          <p>
            Run <code>create-stack add</code> inside a generated project to add a capability or a component. Adding a port with a different provider <strong>swaps it and removes the former provider's files</strong>; pass <code>--keep-files</code> to keep both. Repeat <code>--with</code> to apply several entries: <strong>the CLI checks every entry before it changes a file</strong>. Re-adding a module copies it again.
          </p>
          <pre><code>{ADD_EXAMPLES}</code></pre>
        </section>

        <section>
          <h2 id="components">Components</h2>
          <p>
            Components install from a local shadcn registry, so the project's <code>components.json</code> controls aliases, styles, and icons. <strong>Existing files stay untouched</strong> unless you pass <code>--force</code>.
          </p>
          <div class="docs-table">
            <table class="data-table">
              <caption>Components</caption>
              <thead><tr><th scope="col">Component</th><th scope="col">Provides</th></tr></thead>
              <tbody>
                {COMPONENTS.map((component) => (
                  <tr><th scope="row">{component}</th><td>{COMPONENT_PROVIDES[component]}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <pre><code>{COMPONENT_EXAMPLES}</code></pre>
          <p>
            The dialogs use <a href="https://react-call.desko.dev" rel="noreferrer" target="_blank">react-call</a>.
            The CLI mounts their root in the app shell, so you can await them from anywhere:
          </p>
          <pre><code>{DIALOG_EXAMPLE}</code></pre>
        </section>

        <section>
          <h2 id="after-creation">After creating a project</h2>
          <pre><code>{AFTER_CREATION}</code></pre>
          <p>
            The CLI writes <code>.env</code> with local defaults and <code>.env.example</code> with placeholders. In a monorepo both live in <code>apps/web</code>. It installs dependencies and runs the formatter, typecheck, and linter. Inside an existing repository it leaves Git alone; otherwise it initializes Git and <strong>creates the first commit only after those checks pass</strong>. Without Git <code>user.name</code> or <code>user.email</code> it skips the commit, and <code>--no-install</code> leaves the project <strong>uncommitted</strong>.
          </p>
        </section>
      </article>
    </div>
  </main>
</BaseLayout>

<script>
  import { trackSectionIndex } from '../lib/section-spy'

  trackSectionIndex()
</script>
