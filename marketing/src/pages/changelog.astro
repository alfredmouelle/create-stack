---
import BaseLayout from '../layouts/BaseLayout.astro'
import { CHANGELOG_RELEASES, renderInline } from '../lib/changelog'

const anchor = (version: string) => `v-${version.toLowerCase().replaceAll('.', '-')}`
---

<BaseLayout
  description="A record of the user-facing changes shipped in Create Stack."
  title="Changelog · create-stack"
>
  <main class="shell">
    <header class="page-head">
      <p class="t-label">Releases</p>
      <h1 class="t-h1">Changelog</h1>
      <p class="t-lead">
        Every release adds user-facing value. You always run the latest with <code>@latest</code>.
      </p>
      <a
        class="text-link"
        href="https://github.com/alfredmouelle/create-stack/blob/main/cli/CHANGELOG.md"
        rel="noreferrer"
        target="_blank"
      >
        View source ↗
      </a>
    </header>
    <div class="indexed-page">
      <nav aria-label="Versions" class="section-index">
        {
          CHANGELOG_RELEASES.map((release) => (
            <a data-spy-target={anchor(release.version)} href={`#${anchor(release.version)}`}>
              <b>{release.version}</b>
              {release.date ? <span>{release.date}</span> : null}
            </a>
          ))
        }
      </nav>
      <ol class="timeline">
        {
          CHANGELOG_RELEASES.map((release) => (
            <li class:list={['release', !release.date && 'is-pending']} id={anchor(release.version)}>
              <div class="release-meta">
                <p class="release-version" data-version={release.version}>
                  {release.version}
                </p>
                {release.date ? (
                  <time datetime={release.date}>{release.date}</time>
                ) : (
                  <span>next release</span>
                )}
              </div>
              <span aria-hidden="true" class="release-rail" />
              <div class="release-body">
                {release.sections.length ? (
                  release.sections.map((section) => (
                    <section>
                      <h2 class="release-group">{section.heading}</h2>
                      <ul>
                        {section.items.map((item) => (
                          <li set:html={renderInline(item)} />
                        ))}
                      </ul>
                    </section>
                  ))
                ) : (
                  <p class="is-muted">No entries yet.</p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </main>
</BaseLayout>

<script>
  import { trackSectionIndex } from '../lib/section-spy'

  const index = document.querySelector<HTMLElement>('.section-index')
  if (index) trackSectionIndex(index)
</script>
