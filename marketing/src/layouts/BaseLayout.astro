---
import '../styles/global.css'
import { ClientRouter, fade } from 'astro:transitions'
import ConsentBanner from '../components/ConsentBanner'
import {
  getSiteMetadata,
  OG_IMAGE_ALT,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TITLE,
} from '../lib/site-metadata'

interface Props {
  title?: string
  description?: string
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
} = Astro.props
const metadata = getSiteMetadata()
const canonical = new URL(Astro.url.pathname, metadata.canonicalUrl)
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: '180ms' })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#edf2ef" />
    <meta name="author" content="Alfred Mouelle" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={metadata.ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={metadata.ogImageUrl} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="page-shell header-inner">
        <a class="wordmark" href="/" aria-label="Create Stack home">
          <img
            class="wordmark-mark"
            src="/favicon.svg"
            alt=""
            aria-hidden="true"
            width="30"
            height="30"
          />
          <span>create-stack</span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href="/build">Build</a>
          <a href="/changelog">Changelog</a>
          <a href="/#why">Why Create Stack</a>
          <a class="nav-github" href="https://github.com/alfredmouelle/create-stack">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>
    <slot />
    <ConsentBanner client:load />
    <footer class="site-footer">
      <div class="page-shell footer-inner">
        <div>
          <p>&gt;_ create-stack · made for the first useful commit</p>
          <p class="footer-credit">
            Open source (MIT) on <a href="https://github.com/alfredmouelle/create-stack">GitHub</a>.
            Inspired by <a href="https://create.t3.gg">create-t3-app</a> by Theo Browne.
          </p>
        </div>
        <div class="footer-links">
          <a href="/changelog">Changelog ↗</a>
          <a href="/privacy">Privacy ↗</a>
          <a href="https://www.npmjs.com/package/@alfredmouelle/create-stack">npm ↗</a>
          <a href="https://github.com/alfredmouelle/create-stack">GitHub ↗</a>
        </div>
      </div>
    </footer>
  </body>
</html>
